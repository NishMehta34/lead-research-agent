# --- Model -------------------------------------------------------------
# Default: free local model via Ollama (https://ollama.com)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1

# OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- What you sell (briefs are written from this point of view) ---------
SELLER_DESCRIPTION="We are a software services company that builds custom software, AI-powered applications (RAG, AI agents, document processing), data engineering pipelines and automation for startups and SMEs in the US, UK and Europe."

# --- Research limits ----------------------------------------------------
MAX_EXTRA_PAGES=3
MAX_CHARS_PER_PAGE=4000
REQUEST_TIMEOUT=15
MAX_NOTE_CHARS=200

# --- Loop agent (--loop) -------------------------------------------------
MAX_LOOP_PAGES=6
MAX_LOOP_ROUNDS=4
PAGES_PER_ROUND=2
